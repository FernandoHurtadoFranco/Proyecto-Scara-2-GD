import math
import numpy as np

# Parámetros físicos del SCARA[cite: 10]
L1 = 180.0
L2 = 160.0

def cinematica_inversa(x, y):
    """
    Calcula los ángulos articulares para alcanzar (x, y).
    Utiliza la configuración codo abajo[cite: 7].
    """
    # Ecuación analítica para theta2[cite: 7]
    cos_th2 = (x**2 + y**2 - L1**2 - L2**2) / (2 * L1 * L2)
    
    # Validación del espacio de trabajo (20 mm a 340 mm)[cite: 7]
    if cos_th2 < -1 or cos_th2 > 1:
        raise ValueError("Punto fuera del espacio de trabajo")

    # Selección de codo abajo (theta2 positivo)[cite: 7]
    th2 = math.atan2(math.sqrt(1 - cos_th2**2), cos_th2)

    # Cálculo de theta1 compensando la posición de theta2[cite: 7]
    th1 = math.atan2(y, x) - math.atan2(L2 * math.sin(th2), L1 + L2 * math.cos(th2))

    return math.degrees(th1), math.degrees(th2)

def cinematica_directa(th1_deg, th2_deg):
    """
    Calcula (x, y) a partir de los ángulos articulares[cite: 6].
    """
    th1 = math.radians(th1_deg)
    th2 = math.radians(th2_deg)
    
    x = L1 * math.cos(th1) + L2 * math.cos(th1 + th2)
    y = L1 * math.sin(th1) + L2 * math.sin(th1 + th2)
    
    return x, y
